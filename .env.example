# Copy to .env and adjust. All paths are relative to the repo root unless absolute.
# The CLI reads these from the process environment.

# Raw FastF1 / OpenF1 HTTP cache.
APEX_CACHE_DIR=./data/cache
# Validated, processed sessions (Parquet) and track assets.
APEX_PROCESSED_DIR=./data/processed
# Training runs, checkpoints, TensorBoard logs.
APEX_RUNS_DIR=./runs
